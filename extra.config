# ===== 目标设备 =====
# 老硬件 MT7531 用 rax3000m 的固件，新硬件 AN8855 用 rax3000me 的固件
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y

# ===== 闭源无线与硬件加速（核心，必留）=====
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y

# ===== 常用插件 =====
CONFIG_PACKAGE_luci-app-diskman=y          # 硬盘分区/格式化/挂载
CONFIG_PACKAGE_luci-app-ksmbd=y            # SMB 共享（电视、电脑访问）
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-minidlna=y         # DLNA（电视直接播）
CONFIG_PACKAGE_luci-app-ttyd=y             # 网页终端
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-nlbwmon=y          # 流量统计
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-udpxy=y            # IPTV
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-theme-argon=y

# ===== 硬盘休眠 + 下载机 =====
CONFIG_PACKAGE_hd-idle=y                   # 硬盘空闲休眠
CONFIG_PACKAGE_luci-app-hd-idle=y          # 依赖自带 hd-idle + lsblk
CONFIG_PACKAGE_aria2=y                     # 磁力/BT/HTTP 下载
CONFIG_PACKAGE_luci-app-aria2=y            # 依赖自带 aria2 + ariang
CONFIG_PACKAGE_ariang=y                    # AriaNg 网页界面

# ===== 异地访问 =====
CONFIG_PACKAGE_tailscale=y                 # 零配置组网，无需公网 IP
# 注：源里已无 luci-app-tailscale，只有命令行版，用 ssh 管理

# ===== 游戏优化：DNS =====
CONFIG_PACKAGE_smartdns=y                  # 更快更准的 DNS 解析
CONFIG_PACKAGE_luci-app-smartdns=y         # 依赖自带 smartdns

# ===== 文件管理 =====
CONFIG_PACKAGE_filebrowser=y               # 网页文件管理器
CONFIG_PACKAGE_luci-app-filebrowser=y
# 注：filebrowser 是 Go 程序且需 Node + pnpm 构建前端，编译耗时较长。
#    若编译失败或想省时间，可删掉这两行，改用 apk add 在线安装。

# ===== 按需开启（默认注释掉）=====
# BT/PT 保种（Aria2 做种弱，需要保种时开）
# CONFIG_PACKAGE_transmission-daemon=y
# CONFIG_PACKAGE_transmission-web=y
# 挂载远程 NAS 的 SMB 共享（本地硬盘方案不需要）
# CONFIG_PACKAGE_kmod-fs-cifs=y
# CONFIG_PACKAGE_cifs-utils=y

# ===== 已移除（2026-10-01 确认不再需要）=====
# USB 串口驱动：不玩 Zigbee / Thread
#   kmod-usb-acm / kmod-usb-serial-cp210x / ch341 / ftdi / pl2303
# WireGuard：用户确认不需要
#   luci-app-wireguard / wireguard-tools / kmod-wireguard
